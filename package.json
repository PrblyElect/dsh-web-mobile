{
  "name": "dsh-web-mobile-hardening",
  "version": "1.0.0",
  "description": "Mobile viewport/zoom hardening for the DeepSeek Harness web GUI: viewport lock, safe-area insets, 16px inputs, touch-action, and a sidebar QoL guard",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrblyElect/dsh-web-mobile.git"
  },
  "homepage": "https://github.com/PrblyElect/dsh-web-mobile#readme",
  "bugs": {
    "url": "https://github.com/PrblyElect/dsh-web-mobile/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mobile",
    "viewport",
    "deepseek"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || >=0.1.1-rc.0 <0.2.0 || >=0.1.2-a <0.2.0 || >=0.1.3-a <0.2.0 || >=0.1.5-a <0.2.0 || >=0.1.6-a <0.2.0 || >=0.1.7-a <0.2.0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-a <0.3.0-0 || >=0.2.2-a <0.3.0-0"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
